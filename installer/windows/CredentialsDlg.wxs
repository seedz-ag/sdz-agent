<?xml version="1.0" encoding="UTF-8"?>
<!-- "Credenciais" wizard page: collects CLIENT_ID / CLIENT_SECRET / API_URL (optional: can be filled later through the tray app). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="CredentialsDlg" Width="370" Height="270" Title="[ProductName] - Credenciais">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Credenciais de acesso" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Informe o Client ID e o Client Secret fornecidos pela Seedz (opcional)." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="ClientIdLabel" Type="Text" X="25" Y="62" Width="320" Height="12" NoPrefix="yes" Text="Client ID:" />
        <Control Id="ClientIdEdit" Type="Edit" X="25" Y="75" Width="320" Height="17" Property="CLIENT_ID" />

        <Control Id="ClientSecretLabel" Type="Text" X="25" Y="100" Width="320" Height="12" NoPrefix="yes" Text="Client Secret:" />
        <Control Id="ClientSecretEdit" Type="Edit" X="25" Y="113" Width="320" Height="17" Property="CLIENT_SECRET" Password="yes" />

        <Control Id="ApiUrlLabel" Type="Text" X="25" Y="138" Width="320" Height="12" NoPrefix="yes" Text="URL da API (altere apenas se orientado pela Seedz):" />
        <Control Id="ApiUrlEdit" Type="Edit" X="25" Y="151" Width="320" Height="17" Property="API_URL" />

        <Control Id="Note" Type="Text" X="25" Y="180" Width="320" Height="48" NoPrefix="yes"
                 Text="Se preenchidas, as credenciais são validadas na API da Seedz durante a instalação (credenciais inválidas ou sem internet cancelam a instalação). Os campos podem ficar em branco: o serviço é instalado mesmo assim e as credenciais podem ser preenchidas depois pelo ícone da bandeja (SDZ Agent)." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <!-- both empty = configure later via the tray app; one of them empty = incomplete -->
          <Publish Event="SpawnDialog" Value="CredentialsMissingDlg" Condition="(CLIENT_ID AND NOT CLIENT_SECRET) OR (CLIENT_SECRET AND NOT CLIENT_ID) OR NOT API_URL" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="((CLIENT_ID AND CLIENT_SECRET) OR (NOT CLIENT_ID AND NOT CLIENT_SECRET)) AND API_URL" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="CredentialsMissingDlg" Width="260" Height="85" Title="[ProductName]" NoMinimize="yes">
        <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="40" NoPrefix="yes"
                 Text="Preencha Client ID e Client Secret juntos (ou deixe os dois em branco para configurar depois pela bandeja). A URL da API é obrigatória." />
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="Information icon" FixedSize="yes" IconSize="32" Text="WixUI_Ico_Info" />
        <Control Id="Return" Type="PushButton" X="100" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
