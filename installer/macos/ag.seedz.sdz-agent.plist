<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ag.seedz.sdz-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/sdz-agent/sdz-agent</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/var/lib/sdz-agent</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SDZ_AGENT_DATA_DIR</key>
        <string>/var/lib/sdz-agent</string>
        <key>USE_CONSOLE_LOG</key>
        <string>true</string>
        <key>SDZ_AGENT_SERVICE</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>/var/lib/sdz-agent/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/lib/sdz-agent/logs/launchd.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
