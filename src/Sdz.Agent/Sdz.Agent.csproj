<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sdz-agent</AssemblyName>
    <RootNamespace>Sdz.Agent</RootNamespace>
    <ApplicationIcon Condition="Exists('seedz.ico')">seedz.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- publish defaults: a single self-contained file per RID -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RollForward>LatestMajor</RollForward>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />

    <!-- database drivers -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.13" />

    <!-- transports / io -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.5" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Cronos" Version="0.13.0" />

    <!-- transitive pin: Microsoft.Data.SqlClient pulls a vulnerable 9.0.x (NU1903) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sdz.Agent.Control/Sdz.Agent.Control.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sdz.Agent.Tests" />
  </ItemGroup>

</Project>
