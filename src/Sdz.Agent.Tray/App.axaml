<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sdz.Agent.Tray.App"
             RequestedThemeVariant="Dark">
  <!-- Seedz design system (same tokens as sdz-nfe-agent): dark navy surfaces, brand green primary. -->
  <Application.Resources>
    <Color x:Key="SystemAccentColor">#34D579</Color>
    <SolidColorBrush x:Key="TextControlBackground">#040B1E</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#040B1E</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackgroundFocused">#040B1E</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled">#0D1D42</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrush">#22335F</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#3A4E80</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused">#6E9BFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled">#16244B</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlForeground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlForegroundFocused">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlForegroundDisabled">#6B7BA6</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground">#6B7BA6</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver">#6B7BA6</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused">#6B7BA6</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor">#3A4E80</SolidColorBrush>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <SolidColorBrush x:Key="ToggleSwitchFillOn">#34D579</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver">#03703C</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed">#03703C</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn">#34D579</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver">#03703C</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed">#03703C</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn">#001648</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver">#001648</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed">#001648</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOff">#0D1D42</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver">#16244B</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed">#16244B</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff">#22335F</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver">#3A4E80</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed">#3A4E80</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff">#6B7BA6</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver">#9FADCB</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed">#9FADCB</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchContentForeground">#9FADCB</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarThumbFill">#3A4E80</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver">#6B7BA6</SolidColorBrush>
    <SolidColorBrush x:Key="ScrollBarTrackFill">#081431</SolidColorBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#040B1E" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,Liberation Mono,monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="#0D1D42" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.sm">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="40" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#34D579" />
      <Setter Property="Foreground" Value="#001648" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#03703C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#E11900" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#870F00" />
    </Style>
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#22335F" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0D1D42" />
      <Setter Property="BorderBrush" Value="#22335F" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9FADCB" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0D1D42" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0D1D42" />
      <Setter Property="Foreground" Value="#6B7BA6" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#9FADCB" />
    </Style>
  </Application.Styles>
</Application>
